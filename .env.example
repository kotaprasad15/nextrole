# Copy to .env (never commit .env)
# Key for the provider below (Anthropic key by default, or your DeepSeek key).
ANTHROPIC_API_KEY=
# Leave empty for Anthropic. For DeepSeek (Anthropic-compatible endpoint), uncomment all three:
#   LLM_BASE_URL=https://api.deepseek.com/anthropic
#   MODEL_FAST=deepseek-flash
#   MODEL_STRONG=deepseek-v4-pro
#   LLM_DISABLE_THINKING=true   (otherwise reasoning eats max_tokens and replies come back empty)
# NOTE: resumes contain PII; DeepSeek's hosted API processes data in China. Use sample
# resumes only, or Anthropic / a local model for real users.
LLM_BASE_URL=
LLM_DISABLE_THINKING=false
# Model names live here, never in code. Cheap model for Intake/Tiering/Matcher, strong for Writer/Critic.
MODEL_FAST=claude-haiku-5-5
MODEL_STRONG=claude-sonnet-5-5
# USD per million tokens for cost accounting (verify against current pricing)
PRICE_IN_PER_MTOK=3.0
PRICE_OUT_PER_MTOK=15.0
RUN_MAX_COST_USD=0.50
RUN_MAX_TOKENS=200000
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
TRACE_DIR=traces
DB_PATH=data/nextrole.db
UPLOAD_DIR=data/uploads
# REQUIRED: AES-256-GCM keys for field-level encryption of resumes, profiles and drafts.
# Generate with:  uv run python -m nextrole.security genkey      (prints ENCRYPTION_KEYS=k1:...)
# Format "id:key,id:key": the FIRST key encrypts, every key can decrypt. To rotate, put a new key
# first, run `uv run python -m nextrole.security rotate`, then remove the old key. Never commit it.
ENCRYPTION_KEYS=
# Legacy (first release, Fernet). Only needed to read data written before ENCRYPTION_KEYS existed;
# run `uv run python -m nextrole.security encrypt-existing` once, then you can remove it.
RESUME_ENCRYPTION_KEY=
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
MAX_UPLOAD_MB=5

# ---- web security ----
# "production" forces Secure cookies, HSTS and hides /docs. Serve the API only over HTTPS then.
ENV=development
# Origins of the Next.js app (CSRF Origin check). Comma separated.
ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
# Reverse proxies in front of the API that append to X-Forwarded-For (0 = trust nothing). Set 1 behind
# the Next.js proxy or a load balancer, never when the API is directly reachable.
TRUSTED_PROXY_HOPS=0
# Accounts with these emails become admins at startup (they must already be signed up). Comma separated.
ADMIN_EMAILS=
